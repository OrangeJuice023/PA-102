// Cloudflare Workers (static assets only). Build first with `npm run build`,
// which generates vault/ from content/reviewer.md and runs Quartz into public/.
{
  "name": "pa-102-reviewer",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    // Quartz emits public/404.html.
    "not_found_handling": "404-page"
  }
}
