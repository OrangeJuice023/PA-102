// Cloudflare Workers (static assets only).
// `wrangler deploy` runs the build below first: it regenerates vault/ from
// content/reviewer.md, verifies it, and runs Quartz into public/. So the
// Cloudflare dashboard needs no separate build command.
{
  "name": "pa-102",
  "compatibility_date": "2026-10-06",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./public",
    // Quartz emits public/404.html.
    "not_found_handling": "404-page"
  }
}
